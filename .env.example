# ============================================================
# TOP Training Institute - Vercel / TiDB environment variables
# Copy to .env for local `vercel dev`, and add each in Vercel
# (Project -> Settings -> Environment Variables). NEVER commit real secrets.
# ============================================================

# --- TiDB Serverless (MySQL-compatible) connection ---
# From the TiDB Cloud "Connect" > General panel.
TTI_DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TTI_DB_PORT=4000
TTI_DB_USER=youruserid.root
TTI_DB_PASS=your-database-password
TTI_DB_NAME=top_training_center
# TLS is required for TiDB Serverless; set false only for a local MySQL.
TTI_DB_SSL=true

# --- Session signing secret (stateless auth cookie) ---
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TTI_SESSION_SECRET=replace-with-a-64-char-random-hex-string

# --- Bootstrap administrator (created on first admin login) ---
TTI_ADMIN_EMAIL=admin@example.com
TTI_ADMIN_PASS=change-me-strong-password
TTI_ADMIN_NAME=System Administrator

# --- Site defaults (overridable later from the admin Settings page) ---
TTI_INSTITUTION=TOP TRAINING INSTITUTE
TTI_CURRENCY=ETB
TTI_FEE_REG=500
TTI_FEE_CERT=200

# --- Payment gateway ---
# sandbox records a pending push; no external call is made.
TTI_TELEBIRR_MODE=sandbox
